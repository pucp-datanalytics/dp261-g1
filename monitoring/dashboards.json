{
  "widgets": [
    {
      "type": "metric",
      "properties": {
        "title": "API Latency p95",
        "metrics": [
          ["AWS/ApiGateway", "Latency", "ApiName", "badbuy-api", {"stat": "p95"}]
        ],
        "period": 300,
        "region": "us-east-1"
      }
    },
    {
      "type": "metric",
      "properties": {
        "title": "API 5XX Errors",
        "metrics": [
          ["AWS/ApiGateway", "5XXError", "ApiName", "badbuy-api", {"stat": "Sum"}]
        ],
        "period": 300,
        "region": "us-east-1"
      }
    },
    {
      "type": "log",
      "properties": {
        "title": "Structured API Logs",
        "query": "SOURCE '/aws/badbuy-api' | fields @timestamp, @message | sort @timestamp desc | limit 50",
        "region": "us-east-1"
      }
    }
  ]
}
