{
  "alarms": [
    {
      "name": "api-error-rate-high",
      "metric": "5XXError",
      "threshold": 5,
      "period_seconds": 300,
      "action": "Notify team through SNS"
    },
    {
      "name": "api-latency-high",
      "metric": "LatencyP95",
      "threshold_ms": 2000,
      "period_seconds": 300,
      "action": "Review container health and model load time"
    }
  ]
}
