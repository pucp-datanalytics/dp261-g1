# Optional Lambda container variant. Use only if the model and dependencies fit comfortably.
FROM public.ecr.aws/lambda/python:3.10

ENV MODEL_PATH=/var/task/models/final_model.pkl \
    MODEL_METADATA_PATH=/var/task/handoff/model/model_metadata.json \
    MODEL_THRESHOLD=0.70 \
    API_VERSION=1.0.0 \
    MODEL_VERSION=sprint5-final-threshold-0.70

COPY api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY api/ ./api/
COPY src/ ./src/
COPY handoff/ ./handoff/
COPY models/ ./models/

CMD ["api.lambda_handler.handler"]
